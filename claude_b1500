def _measure_software_sweep(df, inst, active_channels):
“””
混合 Linear 與 List 的情形，以軟體逐點控制所有 SMU。
以 Linear 主掃描 SMU 為迴圈基準。
“””
print(”[B1500] 模式：Software Sweep（混合模式）”)

```
linear_rows = df[df['Mode'].str.strip().str.lower() == 'linear']
const_rows  = df[df['Mode'].str.strip().str.lower() == 'const']
sync_rows   = df[df['Mode'].str.strip().str.lower() == 'sync']
list_rows   = df[df['Mode'].str.strip().str.lower() == 'list']

# 以 Linear 主 SMU 決定掃描點
main_row = linear_rows.sort_values('Priority').iloc[0]
start    = float(main_row['Linear_Start'])
stop     = float(main_row['Linear_Stop'])
num      = int(main_row['Linear_Num'])
sweep_vals = np.linspace(start, stop, num)

results = {ch: {'V': [], 'I': []} for ch in active_channels}

for idx, val in enumerate(sweep_vals):
    # Linear SMU
    for _, row in linear_rows.iterrows():
        ch   = _channel(row['SMU'])
        comp = _parse_compliance(row['Comp'])
        cur_val = np.linspace(float(row['Linear_Start']),
                              float(row['Linear_Stop']),
                              int(row['Linear_Num']))[idx]
        if str(row['Source']).upper() == 'V':
            inst.write(f"DV {ch},0,{_fmt(cur_val)},{_fmt(comp)}")
        else:
            inst.write(f"DI {ch},0,{_fmt(cur_val)},{_fmt(comp)}")

    # Sync SMU
    for _, row in sync_rows.iterrows():
        ch    = _channel(row['SMU'])
        comp  = _parse_compliance(row['Comp'])
        ratio = float(row.get('Sync_Ratio', 1) or 1)
        bias  = float(row.get('Sync_Bias', 0) or 0)
        sync_val = val * ratio + bias
        if str(row['Source']).upper() == 'V':
            inst.write(f"DV {ch},0,{_fmt(sync_val)},{_fmt(comp)}")
        else:
            inst.write(f"DI {ch},0,{_fmt(sync_val)},{_fmt(comp)}")

    # Const SMU
    for _, row in const_rows.iterrows():
        ch   = _channel(row['SMU'])
        comp = _parse_compliance(row['Comp'])
        cval = float(row.get('Const_Set', 0) or 0)
        if str(row['Source']).upper() == 'V':
            inst.write(f"DV {ch},0,{_fmt(cval)},{_fmt(comp)}")
        else:
            inst.write(f"DI {ch},0,{_fmt(cval)},{_fmt(comp)}")

    # List SMU（依 idx 循環取值）
    for _, row in list_rows.iterrows():
        ch      = _channel(row['SMU'])
        comp    = _parse_compliance(row['Comp'])
        lvals   = _parse_list(row.get('List', ''))
        lval    = lvals[idx % len(lvals)] if lvals else 0
        if str(row['Source']).upper() == 'V':
            inst.write(f"DV {ch},0,{_fmt(lval)},{_fmt(comp)}")
        else:
            inst.write(f"DI {ch},0,{_fmt(lval)},{_fmt(comp)}")

    time.sleep(0.05)

    for ch in active_channels:
        inst.write(f"TV {ch},0")
        v_str = inst.read().strip()
        inst.write(f"TI {ch},0")
        i_str = inst.read().strip()
        results[ch]['V'].append(_extract_value(v_str))
        results[ch]['I'].append(_extract_value(i_str))

return results
```

