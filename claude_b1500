import time
import re
import pandas as pd
import numpy as np
from datetime import datetime
from pathlib import Path

# —————————————————————————

# 工具函數

# —————————————————————————

def _parse_compliance(comp_str: str) -> float:
“”“將 ‘1m’, ‘10u’, ‘100m’, ‘1e-3’ 等字串轉為浮點數。”””
if pd.isna(comp_str):
return 0.1
s = str(comp_str).strip().lower()
suffix_map = {‘f’: 1e-15, ‘p’: 1e-12, ‘n’: 1e-9, ‘u’: 1e-6,
‘m’: 1e-3, ‘k’: 1e3, ‘meg’: 1e6, ‘g’: 1e9}
for suffix, factor in sorted(suffix_map.items(), key=lambda x: -len(x[0])):
if s.endswith(suffix):
return float(s[:-len(suffix)]) * factor
return float(s)

def _parse_list(list_str: str) -> list:
“”“將 ‘0.1,0.5,1.7,…’ 字串解析為 float list。”””
if pd.isna(list_str):
return []
return [float(x.strip()) for x in str(list_str).split(’,’) if x.strip()]

def _fmt(val: float) -> str:
“”“格式化浮點數為 B1500 指令用字串（最多 6 位有效數字）。”””
return f”{val:.6g}”

def _channel(smu_num: int) -> int:
“”“SMU 編號 → B1500 channel number（SMU1=1, SMU2=2, …）。”””
return int(smu_num)

def _meas_mode(source: str) -> tuple:
“””
根據 Source 類型決定量測模式。
回傳 (force_mode, meas_v_mode, meas_i_mode)
V source → 量 I；I source → 量 V；兩者都量。
“””
if source.upper() == ‘V’:
return (‘V’, 1, 1)   # force V, meas I(1) & V(1)
else:
return (‘I’, 1, 1)   # force I, meas V(1) & I(1)

def _set_meas_range_all(inst, active_channels: list):
“”“對所有 active channel 設定自動量測範圍（V & I）。”””
for ch in active_channels:
# MM: 量測模式，2=spot measurement
# AAD: auto-ranging
inst.write(f”MM 2,{ch}”)

