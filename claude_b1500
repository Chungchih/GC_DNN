def _wait_opc(inst, timeout_s: float = 120):
“”“等待 B1500 操作完成（*OPC?）。”””
inst.write(”*OPC?”)
deadline = time.time() + timeout_s
while time.time() < deadline:
try:
resp = inst.read().strip()
if resp == ‘1’:
return
except Exception:
pass
time.sleep(0.5)
raise TimeoutError(“B1500 量測逾時！”)

def _extract_value(raw: str) -> float:
“””
從 B1500 回傳字串中提取數值。
格式例：‘NAI+1.23456E-03’ 或 ‘+1.23456E-03’
“””
# 去掉前綴狀態字元（通常 1~3 個英文字母）
s = re.sub(r’^[A-Za-z]+’, ‘’, raw.strip())
try:
return float(s)
except ValueError:
return float(‘nan’)

def _parse_raw_data(raw: str, channels: list, num_points: int) -> dict:
“””
解析 B1500 staircase sweep 回傳的 ASCII 資料。
資料格式（FMT 1,1）：每筆 ‘NXV+1.23E-03’ 或 ‘NXI+4.56E-07’，逗號分隔。
“””
tokens = [t.strip() for t in raw.split(’,’) if t.strip()]
results = {ch: {‘V’: [], ‘I’: []} for ch in channels}

```
# 每個量測點有 len(channels)*2 筆資料（V+I for each channel）
items_per_point = len(channels) * 2
for pt_idx in range(num_points):
    base = pt_idx * items_per_point
    ch_idx = 0
    for i in range(0, items_per_point, 2):
        if base + i + 1 >= len(tokens):
            break
        ch = channels[ch_idx]
        v_token = tokens[base + i]
        i_token = tokens[base + i + 1]
        results[ch]['V'].append(_extract_value(v_token))
        results[ch]['I'].append(_extract_value(i_token))
        ch_idx += 1

return results
```

def _save_result(results: dict, df: pd.DataFrame, out_path: str):
“””
將量測結果儲存為 txt 檔。
格式：每列一個量測點，欄位為各 SMU 的 V 和 I。
“””
# 建立 channel → name 對應
name_map = {}
if ‘Name’ in df.columns:
for _, row in df.iterrows():
try:
name_map[int(row[‘SMU’])] = str(row.get(‘Name’, f”SMU{row[‘SMU’]}”))
except Exception:
pass

```
channels = sorted(results.keys())
num_points = max(len(results[ch]['V']) for ch in channels) if channels else 0

lines = []
lines.append("# B1500 Measurement Result")
lines.append(f"# Timestamp : {datetime.now().isoformat()}")
lines.append(f"# Num Points: {num_points}")
lines.append("#")

# Header
header_parts = ["Index"]
for ch in channels:
    name = name_map.get(ch, f"SMU{ch}")
    header_parts.append(f"SMU{ch}({name})_V[V]")
    header_parts.append(f"SMU{ch}({name})_I[A]")
lines.append("\t".join(header_parts))

# Data
for pt in range(num_points):
    row_parts = [str(pt)]
    for ch in channels:
        v_list = results[ch]['V']
        i_list = results[ch]['I']
        v_val = v_list[pt] if pt < len(v_list) else float('nan')
        i_val = i_list[pt] if pt < len(i_list) else float('nan')
        row_parts.append(f"{v_val:.6E}")
        row_parts.append(f"{i_val:.6E}")
    lines.append("\t".join(row_parts))

Path(out_path).parent.mkdir(parents=True, exist_ok=True)
with open(out_path, 'w', encoding='utf-8') as f:
    f.write("\n".join(lines))
    f.write("\n")
```