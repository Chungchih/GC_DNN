# 量測策略 A：Staircase Sweep（Linear + Sync + Const）

# —————————————————————————

def _measure_staircase(df, inst, active_channels, linear_rows, const_rows, sync_rows):
“””
使用 B1500 WV/WSV/WT/WM/WNX 指令執行 staircase sweep。
Linear SMU → WV（主掃描）
Sync   SMU → WSV（同步掃描，使用 WNSUB 機制）
Const  SMU → DV/DI（固定輸出）
量測   SMU → 全部 channel 的 V & I
“””
print(”[B1500] 模式：Staircase Sweep”)

```
# 2-a. 設定 Const SMU
for _, row in const_rows.iterrows():
    ch   = _channel(row['SMU'])
    comp = _parse_compliance(row['Comp'])
    val  = float(row.get('Const_Set', 0) or 0)
    if str(row['Source']).upper() == 'V':
        inst.write(f"DV {ch},0,{_fmt(val)},{_fmt(comp)}")
    else:
        inst.write(f"DI {ch},0,{_fmt(val)},{_fmt(comp)}")

# 2-b. 設定主 Linear SMU（取 Priority 最小者）
main_row = linear_rows.sort_values('Priority').iloc[0]
main_ch  = _channel(main_row['SMU'])
start    = float(main_row['Linear_Start'])
stop     = float(main_row['Linear_Stop'])
num      = int(main_row['Linear_Num'])
comp_lm  = _parse_compliance(main_row['Comp'])
src_type = 1 if str(main_row['Source']).upper() == 'V' else 2  # 1=V,2=I

# WV ch, mode, range, start, stop, step, Icomp / WI ch,...
step = (stop - start) / (num - 1) if num > 1 else 0
if str(main_row['Source']).upper() == 'V':
    inst.write(f"WV {main_ch},1,0,{_fmt(start)},{_fmt(stop)},{_fmt(step)},{_fmt(comp_lm)}")
else:
    inst.write(f"WI {main_ch},1,0,{_fmt(start)},{_fmt(stop)},{_fmt(step)},{_fmt(comp_lm)}")

# 2-c. 設定 Sync SMU（WSV / WSI）
for _, row in sync_rows.iterrows():
    ch   = _channel(row['SMU'])
    comp = _parse_compliance(row['Comp'])
    ratio = float(row.get('Sync_Ratio', 1) or 1)
    bias  = float(row.get('Sync_Bias', 0) or 0)
    if str(row['Source']).upper() == 'V':
        inst.write(f"WSV {ch},0,{_fmt(ratio)},{_fmt(bias)},{_fmt(comp)}")
    else:
        inst.write(f"WSI {ch},0,{_fmt(ratio)},{_fmt(bias)},{_fmt(comp)}")

# 2-d. 設定量測 channel（全部量 V & I）
# MM 16 = staircase sweep measurement
ch_list_str = ','.join(str(c) for c in active_channels)
inst.write(f"MM 16,{ch_list_str}")

# CMM: 每個 channel 量 V 和 I（mode 3 = V+I）
for ch in active_channels:
    inst.write(f"CMM {ch},3")

# 設定積分時間
inst.write("AIT 0,0.01")  # short mode, 10ms

# 2-e. 執行量測
inst.write("XE")
_wait_opc(inst)

# 2-f. 讀取資料
raw = inst.read()
return _parse_raw_data(raw, active_channels, num)
```

