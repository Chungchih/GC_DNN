# 主量測函數

# —————————————————————————

def run_b1500_measurement(
df: pd.DataFrame,
inst,
output_dir: str = “.”,
filename_prefix: str = “B1500_result”
) -> str:
“””
根據設定 DataFrame 設定 B1500 並執行量測。

```
Parameters
----------
df : pd.DataFrame
    從 CSV 讀取的量測設定，欄位說明見模組文件。
inst : pyvisa.Resource
    已連接的 B1500 VISA 物件。
output_dir : str
    結果 txt 儲存目錄，預設當前目錄。
filename_prefix : str
    結果檔名前綴。

Returns
-------
str
    儲存結果的 txt 檔案路徑。
"""

# --- 0. 正規化欄位名稱（容錯）---
col_map = {
    'smu': 'SMU', 'name': 'Name', 'mode': 'Mode',
    'priority': 'Priority', 'source': 'Source', 'comp': 'Comp',
    'const_set': 'Const_Set', 'const set': 'Const_Set',
    'linear_start': 'Linear_Start', 'linear start': 'Linear_Start',
    'linear_stop': 'Linear_Stop', 'linear stop': 'Linear_Stop',
    'linear_num': 'Linear_Num', 'linear num': 'Linear_Num',
    'sync_syncsmu': 'Sync_syncSMU', 'syncsmu': 'Sync_syncSMU',
    'sync_ratio': 'Sync_Ratio', 'sync_bias': 'Sync_Bias',
    'list': 'List',
}
df = df.rename(columns={c: col_map.get(c.lower().replace(' ', '_'), c)
                         for c in df.columns})

# 確保必要欄位存在
required = ['SMU', 'Mode', 'Source', 'Comp']
for col in required:
    if col not in df.columns:
        raise ValueError(f"DataFrame 缺少必要欄位：{col}")

# 過濾掉 Mode 為 '-' 或空白的列
df = df[df['Mode'].notna() & (df['Mode'].astype(str).str.strip() != '-')].copy()
df['SMU'] = df['SMU'].astype(int)

# --- 1. 重置儀器 ---
print("[B1500] 重置儀器...")
inst.write("*RST")
time.sleep(2)
inst.write("*CLS")
inst.write("FMT 1,1")   # ASCII format, with header
inst.write("AV 1,1")    # averaging: 1 sample

# 取得所有 active channel
active_channels = sorted(df['SMU'].tolist())

# --- 2. 識別量測模式 ---
# 找出 Linear 主掃描 SMU（Priority 最小且 Mode==Linear）
linear_rows = df[df['Mode'].str.strip().str.lower() == 'linear']
const_rows  = df[df['Mode'].str.strip().str.lower() == 'const']
sync_rows   = df[df['Mode'].str.strip().str.lower() == 'sync']
list_rows   = df[df['Mode'].str.strip().str.lower() == 'list']

has_linear = len(linear_rows) > 0
has_list   = len(list_rows) > 0

# 決定量測策略
if has_linear and not has_list:
    result_data = _measure_staircase(df, inst, active_channels,
                                     linear_rows, const_rows, sync_rows)
elif has_list and not has_linear:
    result_data = _measure_list(df, inst, active_channels,
                                list_rows, const_rows, sync_rows)
elif not has_linear and not has_list:
    result_data = _measure_spot(df, inst, active_channels, const_rows)
else:
    # 混合情形：以軟體逐點控制
    result_data = _measure_software_sweep(df, inst, active_channels)

# --- 3. 儲存結果 ---
timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
out_path = str(Path(output_dir) / f"{filename_prefix}_{timestamp}.txt")
_save_result(result_data, df, out_path)
print(f"[B1500] 量測完成，結果儲存於：{out_path}")
return out_path
```

