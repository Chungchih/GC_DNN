# 1. 支援正負數的 ADC 量化器 (-128 ~ 127)
class ADCQuantizerSigned(nn.Module):
    def __init__(self, num_bits=8):
        super(ADCQuantizerSigned, self).__init__()
        self.qmax = (2 ** (num_bits - 1)) - 1  # 127
        self.qmin = -(2 ** (num_bits - 1))     # -128
        # 可訓練的縮放因子
        self.scale = nn.Parameter(torch.tensor(1.0))

    def forward(self, x):
        scale = torch.clamp(self.scale, min=1e-5)
        x_scaled = x / scale
        x_quant = torch.clamp(torch.round(x_scaled), self.qmin, self.qmax)
        x_dequant = x_quant * scale
        # STE (Straight-Through Estimator)
        return x + (x_dequant - x).detach()

# (前述的 WeightQuantizer 保持不變，因為本來就是對稱的正負量化)
class WeightQuantizer(nn.Module):
    def __init__(self, num_bits=8):
        super(WeightQuantizer, self).__init__()
        self.qmax = (2 ** (num_bits - 1)) - 1
        self.qmin = -self.qmax

    def forward(self, w):
        scale = w.abs().max() / self.qmax
        scale = torch.clamp(scale, min=1e-5)
        w_quant = torch.clamp(torch.round(w / scale), self.qmin, self.qmax)
        w_dequant = w_quant * scale
        return w + (w_dequant - w).detach()

# 2. QAT 網路架構 (改用 LeakyReLU 保留負數訊號)
class OpticalMnistQAT(nn.Module):
    def __init__(self):
        super(OpticalMnistQAT, self).__init__()
        self.weight_q = WeightQuantizer(num_bits=8)
        
        self.conv1 = nn.Conv2d(1, 16, kernel_size=3, padding=1)
        self.adc1 = ADCQuantizerSigned(num_bits=8)
        self.pool1 = nn.MaxPool2d(2, 2)
        
        self.conv2 = nn.Conv2d(16, 32, kernel_size=3, padding=1)
        self.adc2 = ADCQuantizerSigned(num_bits=8)
        self.pool2 = nn.MaxPool2d(2, 2)
        
        self.fc1 = nn.Linear(32 * 7 * 7, 128)
        self.adc3 = ADCQuantizerSigned(num_bits=8)
        
        self.fc2 = nn.Linear(128, 10)

    def forward(self, x):
        w1 = self.weight_q(self.conv1.weight)
        x = F.leaky_relu(F.conv2d(x, w1, self.conv1.bias, padding=1), 0.1)
        x = self.adc1(x)
        x = self.pool1(x)

        w2 = self.weight_q(self.conv2.weight)
        x = F.leaky_relu(F.conv2d(x, w2, self.conv2.bias, padding=1), 0.1)
        x = self.adc2(x)
        x = self.pool2(x)

        x = x.view(x.size(0), -1)

        w3 = self.weight_q(self.fc1.weight)
        x = F.leaky_relu(F.linear(x, w3, self.fc1.bias), 0.1)
        x = self.adc3(x)

        w4 = self.weight_q(self.fc2.weight)
        x = F.linear(x, w4, self.fc2.bias)
        return x



